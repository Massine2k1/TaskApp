{% extends "template.back.twig" %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-8">
        <div class="cosmic-card stellar-rise">
            <div class="card-header bg-transparent border-bottom-0 p-4 pb-0">
                <h2 class="montserrat h3 fw-bold text-center text-md-start">
                    <i class="bi bi-plus-circle me-2" style="color: var(--quantum-blue);"></i>Nouvelle Tâche Spatiale
                </h2>
            </div>
            
            <div class="card-body p-3 p-md-4 p-lg-5">
                {% if error is not empty%}
                <div class="cosmic-card mb-4" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle text-danger me-3"></i>
                            {% for item in error %}                                
                            <p class="text-danger mb-0">{{ item }}</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                
                <form method="post">
                    <input type="hidden" name="user_id" value="{{ session.id }}">
                    
                    <div class="row g-3 g-md-4">
                        <div class="col-12">
                            <label for="task_title" class="form-label text-comet fw-semibold">
                                Titre de la mission <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control cosmic-input" 
                                   id="task_title" 
                                   name="task_title" 
                                    maxlength="100"
                                    minlength = "3"
                                    required
                                   placeholder="Ex: Préparer le lancement du projet Alpha">
                            <div class="form-text text-comet">Entre 3 et 100 caractères</div>
                        </div>
                        
                        <div class="col-12">
                            <label for="task_desc" class="form-label text-comet fw-semibold">Description de la mission</label>
                            <textarea class="form-control cosmic-input" 
                                      id="task_desc" 
                                      name="task_desc" 
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Décrivez les détails de votre mission spatiale..."></textarea>
                            <div class="form-text text-comet">Maximum 500 caractères</div>
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label for="task_due_date" class="form-label text-comet fw-semibold">Date d'échéance</label>
                            <input type="date" 
                                class="form-control cosmic-input" 
                                id="task_due_date" 
                                min="{{ 'now'|date('Y-m-d') }}" 
                                required
                                name="task_due_date">
                        </div>
                    </div>
                    
                    <div class="d-flex flex-column flex-md-row gap-3 mt-4 pt-3">
                        <button type="submit" class="btn stellar-btn flex-fill">
                            <i class="bi bi-rocket me-2"></i>Lancer la mission
                        </button>
                        <a href="./" class="btn cosmic-btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-2"></i>Retour aux missions
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{% block css %}
{{ parent() }}
<link href="./css/forms.css" rel="stylesheet">
{% endblock %}
{% endblock %}