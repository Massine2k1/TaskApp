{% extends "base.html.twig" %}

{% block body %}
<!-- Mobile Navbar (seulement sur mobile) -->
<nav class="navbar navbar-expand-lg navbar-dark mobile-navbar d-lg-none">
    <div class="container-fluid">
        <a class="navbar-brand montserrat fw-bold" href="./">
            <i class="bi bi-stars text-warning me-2"></i>TaskFlow
        </a>
        
        <button class="navbar-toggler stellar-btn" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#mobileNavbarContent"
                aria-controls="mobileNavbarContent" 
                aria-expanded="false" 
                aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>
        
        <div class="collapse navbar-collapse" id="mobileNavbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ pg == 'addtask' ? 'active' }}" href="./?pg=addtask">
                        <i class="bi bi-plus-circle me-1"></i>Nouvelle tâche
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ pg == 'tasklist' or pg is not defined ? 'active' }}" href="./">
                        <i class="bi bi-list-task me-1"></i>Mes tâches
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ pg == 'calendrier' ? 'active' }}" href="./?pg=calendrier">
                        <i class="bi bi-calendar3 me-1"></i>Calendrier
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ pg == 'dashboard' ? 'active' }}" href="./?pg=dashboard">
                        <i class="bi bi-bar-chart me-1"></i>Dashboard
                    </a>
                </li>
            </ul>
            
            <div class="navbar-nav">
                <a class="nav-link text-warning" href="./?pg=deconnexion">
                    <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
                </a>
            </div>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Desktop (seulement sur desktop) -->
        <div class="col-lg-2 orbit-sidebar d-none d-lg-block">
            <div class="position-sticky pt-4">
                <div class="text-center mb-5">
                    <h5 class="montserrat fw-bold mb-2" style="background: linear-gradient(135deg, #fff, var(--quantum-blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="bi bi-stars text-warning me-2"></i>TaskFlow
                    </h5>
                    <small class="text-comet">Espace cosmique</small>
                </div>
                
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link {{ pg == 'addtask' ? 'active' }}" href="./?pg=addtask">
                            <i class="bi bi-plus-circle me-2"></i>Nouvelle tâche
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ pg == 'tasklist' or pg is not defined ? 'active' }}" href="./">
                            <i class="bi bi-list-task me-2"></i>Mes tâches
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ pg == 'calendrier' ? 'active' }}" href="./?pg=calendrier">
                            <i class="bi bi-calendar3 me-2"></i>Calendrier
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ pg == 'dashboard' ? 'active' }}" href="./?pg=dashboard">
                            <i class="bi bi-bar-chart me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item mt-4 pt-3 border-top border-secondary">
                        <a class="nav-link text-comet" href="./?pg=deconnexion">
                            <i class="bi bi-rocket-takeoff me-2"></i>Déconnexion
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <main class="col-12 col-lg-10 px-3 px-md-4">
            <!-- Desktop Header (seulement sur desktop) -->
            <div class="d-none d-lg-block pt-4 pb-2 mb-4 border-bottom border-secondary">
                <h1 class="h3 montserrat fw-bold" style="background: linear-gradient(135deg, #fff, var(--quantum-blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    {% block page_title %}Tableau de bord{% endblock %}
                </h1>
            </div>
            
            {% block content %}
            {% endblock %}
        </main>
    </div>
</div>
{% endblock %}