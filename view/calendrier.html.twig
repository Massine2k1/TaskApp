{% extends "template.back.twig" %}

{% block title %}{{ parent() }} | Calendrier {% endblock %}

{% block content %}
<div>
  <div>
    <button id="prev">&lt;</button>
    <span id="monthYear">Chargement...</span>
    <button id="next">&gt;</button>
  </div>

  <table id="calendar" style="border-collapse:collapse; width:100%">
    <thead>
      <tr>
        <th style="border:1px solid #ccc;">Lun</th>
        <th style="border:1px solid #ccc;">Mar</th>
        <th style="border:1px solid #ccc;">Mer</th>
        <th style="border:1px solid #ccc;">Jeu</th>
        <th style="border:1px solid #ccc;">Ven</th>
        <th style="border:1px solid #ccc;">Sam</th>
        <th style="border:1px solid #ccc;">Dim</th>
      </tr>
    </thead>
    <tbody id="body">
    </tbody>
  </table>
</div>

<style>
  td {     /* Enlève le padding du TD pour qu'il soit plat */
      padding: 0; 
      border: 1px solid #ddd; 
      height: 70px; 
      vertical-align: top; 
      position: relative; /* Ajouté pour s'assurer que le contenu est bien positionné */
  }
  /* Minimal style: only green background for task cells */
  .has-task { background:#90EE90 !important; }
  .cell-link {
        /* Rend le lien une boîte qui prend toute la place disponible */
        display: block; 
        width: 100%;
        height: 100%;
        box-sizing: border-box; /* S'assure que le padding n'augmente pas la taille */
        
        /* Réapplique le padding que vous aviez sur le TD */
        padding: 8px; 
        
        text-decoration: none; /* Enlève le soulignement du lien */
        color: inherit; /* Utilise la couleur du texte de base du TD */
    }
</style>

{% endblock %}

{% block javascript %}
<script>
(() => {
  // Minimal calendar that fetches tasks per month and marks cells with class 'has-task'
  let month = new Date().getMonth() + 1; // 1-12
  let year = new Date().getFullYear();

  const monthYearEl = document.getElementById('monthYear');
  const body = document.getElementById('body');

  document.getElementById('prev').addEventListener('click', () => { changeMonth(-1); });
  document.getElementById('next').addEventListener('click', () => { changeMonth(1); });

  function changeMonth(delta) {
    month += delta;
    if (month < 1) { month = 12; year -= 1; }
    if (month > 12) { month = 1; year += 1; }
    load();
  }

  function formatDate(y,m,d){
    return `${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
  }

  async function load(){
    monthYearEl.textContent = `${month}/${year}`;
    body.innerHTML = '<tr><td colspan="7">Chargement...</td></tr>';

    try {
      const res = await fetch(`?pg=api_calendar&month=${month}&year=${year}`);
      if (!res.ok) throw new Error(res.statusText);
      const json = await res.json();
      const tasks = json.tasks || [];
      console.log(tasks);
      
      // Build a set of dates that have tasks for quick lookup
      const dates = new Set(tasks.map(t => t.task_due_date));

      // Render calendar grid
      const firstDay = new Date(year, month - 1, 1).getDay(); 
      const start = firstDay === 0 ? 6 : firstDay - 1;
      const days = new Date(year, month, 0).getDate();

      body.innerHTML = '';
      let cur = 1;

      for (let week=0; week<6; week++){
        const tr = document.createElement('tr');
        for (let d=0; d<7; d++){
          const td = document.createElement('td');
          if (week===0 && d<start){
            td.textContent = '';
          } else if (cur <= days){
            td.textContent = cur;
            const dateStr = formatDate(year, month, cur);
            tasks.forEach(e => {
              if (e.task_due_date==dateStr){
                url =`http://taskapp/public/?pg=update&id=${e.id}`;
                const link = document.createElement('a');
                link.setAttribute('href',url);
                link.classList.add('cell-link');

                link.innerHTML = td.innerHTML;
                td.innerHTML = '';
                td.appendChild(link);
                td.classList.add('has-task');
              }
            });
            cur++;
          } else {
            td.textContent = '';
          }
          tr.appendChild(td);
        }
        body.appendChild(tr);
        if (cur > days) break;
      }

    } catch (e){
      body.innerHTML = `<tr><td colspan="7">Erreur: ${e.message}</td></tr>`;
    }
  }

  load();
})();
</script>
{% endblock %}