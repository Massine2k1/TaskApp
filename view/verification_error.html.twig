{% extends "template.front.twig" %}

{% block content %}
<div class="card card-modern border-0 text-center">
    <div class="card-body p-5">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
        </div>
        
        <h2 class="fw-bold text-dark mb-3">Échec de la vérification</h2>
        
        {% if error is defined %}
        <div class="alert alert-danger border-0">
            <i class="bi bi-x-circle me-2"></i>
            {{ error }}
        </div>
        {% endif %}
        
        <p class="text-muted mb-4">
            Une erreur est survenue lors de la vérification de votre compte.
        </p>
        
        <div class="d-flex gap-3 justify-content-center">
            <a href="./?pg=inscription" class="btn btn-outline-primary">
                <i class="bi bi-person-plus me-2"></i>Réessayer l'inscription
            </a>
            <a href="./" class="btn btn-gradient">
                <i class="bi bi-house me-2"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}