{% extends "template.front.twig" %}

{% block css %}
{{ parent() }}
<link href="./css/forms.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="row justify-content-center align-items-center min-vh-80 py-4">
    <div class="col-12 col-md-10 col-lg-8 col-xl-6">
        <div class="cosmic-card border-0 stellar-rise">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-stars display-4 mb-3 icon-gradient-register"></i>
                    <h2 class="montserrat h3 fw-bold mb-2">Créer un compte</h2>
                    <p class="text-comet">Rejoignez l'aventure cosmique</p>
                </div>

                <form method="post" action="">
                    <div class="row g-3 g-md-4">
                        <div class="col-12">
                            <label for="username" class="form-label text-comet fw-semibold">Nom d'utilisateur</label>
                            <div class="input-group cosmic-input">
                                <span class="input-group-text bg-dark border-end-0 text-comet">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" class="form-control bg-dark border-start-0 text-stardust" id="username" name="user_name" required placeholder="Choisissez un nom unique">
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="email" class="form-label text-comet fw-semibold">Adresse email</label>
                            <div class="input-group cosmic-input">
                                <span class="input-group-text bg-dark border-end-0 text-comet">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control bg-dark border-start-0 text-stardust" id="email" name="user_email" required placeholder="votre@email.com">
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="password" class="form-label text-comet fw-semibold">Mot de passe</label>
                            <div class="input-group cosmic-input">
                                <span class="input-group-text bg-dark border-end-0 text-comet">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" class="form-control bg-dark border-start-0 text-stardust" id="password" name="user_pwd" required placeholder="Créez un mot de passe">
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="passwordClone" class="form-label text-comet fw-semibold">Confirmation</label>
                            <div class="input-group cosmic-input">
                                <span class="input-group-text bg-dark border-end-0 text-comet">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input type="password" class="form-control bg-dark border-start-0 text-stardust" id="passwordClone" name="user_pwd_clone" required placeholder="Confirmez le mot de passe">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn stellar-btn w-100 py-2 fw-semibold mt-4 mb-3">
                        <i class="bi bi-rocket me-2"></i>Décoller maintenant
                    </button>
                </form>

                {% if error is not null %}
                <div class="cosmic-card border-0 mt-3 error-card">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle text-danger me-3"></i>
                            <p class="text-danger mb-0 small">{{ error }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="text-center mt-4">
                    <p class="text-comet mb-0">Déjà un compte ? 
                        <a href="./?pg=connexion" class="text-decoration-none fw-semibold link-quantum">Se connecter</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}