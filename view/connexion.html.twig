{% extends "template.front.twig" %}

{% block css %}
{{ parent() }}
<link href="./css/forms.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="row justify-content-center align-items-center min-vh-80">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="cosmic-card border-0 stellar-rise">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-rocket display-4 mb-3 icon-gradient-form"></i>
                    <h2 class="montserrat h3 fw-bold mb-2">Connexion</h2>
                    <p class="text-comet">Accédez à votre espace cosmique</p>
                </div>

                <form method="post" action="">
                    <div class="mb-4">
                        <label for="username" class="form-label text-comet fw-semibold">Nom d'utilisateur</label>
                        <div class="input-group cosmic-input">
                            <span class="input-group-text bg-dark border-end-0 text-comet">
                                <i class="bi bi-person"></i>
                            </span>
                            <input type="text" class="form-control bg-dark border-start-0 text-stardust" id="username" name="user_name" required placeholder="Votre nom d'utilisateur">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label text-comet fw-semibold">Mot de passe</label>
                        <div class="input-group cosmic-input">
                            <span class="input-group-text bg-dark border-end-0 text-comet">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password" class="form-control bg-dark border-start-0 text-stardust" id="password" name="user_pwd" required placeholder="Votre mot de passe">
                        </div>
                    </div>

                    <button type="submit" class="btn stellar-btn w-100 py-2 fw-semibold mb-3">
                        <i class="bi bi-rocket me-2"></i>Se connecter
                    </button>
                </form>

                <div class="text-center">
                    <p class="text-comet mb-0">Pas encore de compte ? 
                        <a href="./?pg=inscription" class="text-decoration-none fw-semibold link-quantum">S'inscrire</a>
                    </p>
                </div>
                
                {% if error is not null %}
                <div class="cosmic-card border-0 mt-3 error-card">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle text-danger me-3"></i>
                            <p class="text-danger mb-0 small">{{ error }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}