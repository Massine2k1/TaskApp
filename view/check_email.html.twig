{% extends "template.front.twig" %}

{% block content %}
<div class="row justify-content-center align-items-center min-vh-80 py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="cosmic-card border-0 text-center stellar-rise">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <i class="bi bi-envelope-check display-4" style="background: linear-gradient(135deg, var(--quantum-blue), var(--pulsar-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                </div>
                
                <h2 class="montserrat h3 fw-bold text-stardust mb-3">Mission de Vérification</h2>
                
                <p class="text-comet mb-4 fs-6">
                    Un lien de confirmation a été envoyé à l'adresse 
                    <strong class="text-quantum">{{ email }}</strong>. 
                    Merci de cliquer dessus pour valider votre inscription.
                </p>
                
                <div class="cosmic-card border-0 mt-4" style="background: rgba(37, 99, 235, 0.1);">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-info-circle text-quantum me-3"></i>
                            <p class="text-quantum mb-0 small">Pensez à vérifier vos courriers indésirables</p>
                        </div>
                    </div>
                </div>
                
                <a href="./" class="btn stellar-btn mt-4">
                    <i class="bi bi-house me-2"></i>Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.text-quantum {
    color: var(--quantum-blue) !important;
}

@media (max-width: 768px) {
    .min-vh-80 {
        min-height: 70vh;
    }
}
</style>
{% endblock %}